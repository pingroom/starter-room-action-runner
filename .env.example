# Required: copy the exact sender.id of your trusted TEAMMATE from npm run inspect.
# Do not use a display name, public User ID, or the account that connected the robot.
PINGROOM_TRUSTED_SENDER_ID=
# Existing quick-action slot, 1–16. This project never edits room actions.
PINGROOM_ACTION_NUMBER=1

# Optional: use BOTH instead of npm run connect (for example in CI).
# PINGROOM_TOKEN=your-robot-token
# PINGROOM_ROOM=your-room-code
